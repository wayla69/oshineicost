# Template for backend/.env (copy to backend/.env and fill in). .env is gitignored.
# MSSQL (Easy POS HQ) read-only sync source — used by sync_mssql.py
OSH_SVR=<sql-server-host>
OSH_PORT=<port>
OSH_USER=<readonly-user>
OSH_PWD=<password>
OSH_DB=HQ_Oshinei

# Telegram alerts (fetch_feedback.py: new negative reviews) - bot token from @BotFather + the chat/group id
OSHINEI_TG_TOKEN=
OSHINEI_TG_CHAT_ID=

# Meta webhook receiver (/api/feedback/webhook/meta) for Instagram @mentions - the app secret + the verify token you chose in the Meta app; set the SAME two as Fly secrets
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
