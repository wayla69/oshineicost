{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oshinei-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8010"
      ],
      "cwd": "${workspaceFolder}/backend",
      "port": 8010
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8011"
      ],
      "cwd": "${workspaceFolder}/docs",
      "port": 8011
    }
  ]
}