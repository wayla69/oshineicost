{
  "version": "0.0.1",
  "_comment": "runtimeExecutable is 'py -3.14', never bare 'python': PATH resolves 'python' to Programs\\Python\\Python312, which has NO fastapi/uvicorn/pymssql. The real environment is the Python Install Manager build (pythoncore-3.14) that also carries pytest. Same root cause _python.bat documents for the scheduled syncs - keep the two in lockstep.",
  "configurations": [
    {
      "name": "oshinei-backend",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.14",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8010"
      ],
      "cwd": "${workspaceFolder}/backend",
      "port": 8010
    },
    {
      "name": "oshinei-tier",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.14",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8016"
      ],
      "cwd": "${workspaceFolder}/backend",
      "port": 8016
    },
    {
      "name": "oshinei-auth",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.14",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8012"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "OSHINEI_AUTH": "1",
        "OSHINEI_AUTH_SECRET": "local-verify-secret"
      },
      "port": 8012
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.14",
        "-m",
        "http.server",
        "8011"
      ],
      "cwd": "${workspaceFolder}/docs",
      "port": 8011
    },
    {
      "name": "recon",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.14",
        "-m",
        "uvicorn",
        "recon.main:app",
        "--port",
        "8014"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "OSHINEI_DB": "backend/oshinei.db"
      },
      "port": 8014
    },
    {
      "name": "recon-preview",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.14",
        "-m",
        "uvicorn",
        "recon.main:app",
        "--port",
        "8015"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "OSHINEI_DB": "C:\\Users\\ASUS\\AppData\\Local\\Temp\\recon_verify.db"
      },
      "port": 8015
    },
    {
      "name": "recon-ux",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.14",
        "-m",
        "uvicorn",
        "recon.main:app",
        "--port",
        "8013"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "OSHINEI_DB": "_uxtest.db"
      },
      "port": 8013
    }
  ]
}
