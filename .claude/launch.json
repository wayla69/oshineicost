{
  "version": "0.0.1",
  "_comment": "runtimeExecutable is 'py -3.12', never bare 'python': 3.12 carries the PINNED production versions (fastapi 0.141 / starlette 1.6, same as Fly and CI); the 3.14 install has an older FastAPI that behaves differently (a recon route test passed there and failed on CI, 2026-09-04). PATH's bare 'python' may be an interpreter without fastapi/uvicorn/pymssql - see _python.bat. Keep in lockstep with scripts/gate.sh.",
  "configurations": [
    {
      "name": "oshinei-backend",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8010"
      ],
      "cwd": "${workspaceFolder}/backend",
      "port": 8010
    },
    {
      "name": "oshinei-tier",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8016"
      ],
      "cwd": "${workspaceFolder}/backend",
      "port": 8016
    },
    {
      "name": "oshinei-auth",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8012"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "OSHINEI_AUTH": "1",
        "OSHINEI_AUTH_SECRET": "local-verify-secret"
      },
      "port": 8012
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-m",
        "http.server",
        "8011"
      ],
      "cwd": "${workspaceFolder}/docs",
      "port": 8011
    },
    {
      "name": "recon",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-m",
        "uvicorn",
        "recon.main:app",
        "--port",
        "8014"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "OSHINEI_DB": "backend/oshinei.db"
      },
      "port": 8014
    },
    {
      "name": "recon-preview",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-m",
        "uvicorn",
        "recon.main:app",
        "--port",
        "8015"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "OSHINEI_DB": "C:\\Users\\ASUS\\AppData\\Local\\Temp\\recon_verify.db"
      },
      "port": 8015
    },
    {
      "name": "recon-ux",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-m",
        "uvicorn",
        "recon.main:app",
        "--port",
        "8013"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "OSHINEI_DB": "_uxtest.db"
      },
      "port": 8013
    }
  ]
}